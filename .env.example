# Copy to .env.local for local dev, and add the same keys in your host's dashboard.

# Public URL of the site (used for canonical URLs, sitemap, schema). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas connection string. Leave blank to run in demo mode
# (listings come from data/demo-listings.json and leads are only logged).
MONGODB_URI=

# Lead emails via Resend (free: 3,000/mo, 100/day). Verify your domain in Resend first —
# until then it can only deliver to your own Resend account email.
RESEND_API_KEY=
# Sender on your verified domain, e.g.  Website Leads <leads@yourstudio.com>
LEAD_FROM_EMAIL=
# Optional: override recipients (comma-separated). Default: site.config leads.notifyTo, then agent.email
LEAD_NOTIFY_EMAIL=

# Optional: where to send new leads (Zapier/Make/n8n webhook, Slack incoming webhook, CRM).
LEAD_WEBHOOK_URL=

# Optional: instant home-value estimates on /home-valuation via RentCast's AVM.
# Without it the valuation tool still captures the lead and promises a personal CMA.
RENTCAST_API_KEY=

# ---- MLS / IDX feed (RESO Web API) — only after the MLS approves your data license ----
# Examples: https://api.mlsgrid.com/v2   or   https://api.bridgedataoutput.com/api/v2/OData/<dataset>
RESO_BASE_URL=
RESO_ACCESS_TOKEN=
# Resource name, usually Property
RESO_RESOURCE=Property
# Filter applied to EVERY request (some feeds require it, e.g. MLS Grid: OriginatingSystemName eq 'xyz')
RESO_BASE_FILTER=
# $expand value for photos (MLS Grid / most feeds: Media). Leave blank if your feed returns Media inline.
RESO_EXPAND=Media
